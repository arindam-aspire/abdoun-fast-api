# Application
APP_NAME=Abdoun Real Estate API
API_V1_PREFIX=/api/v1
ENVIRONMENT=local
DEBUG=false

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/realestate
# DATABASE_URL_FALLBACK is used only when DATABASE_URL and DB_* are unset
# DATABASE_URL_FALLBACK=postgresql+psycopg2://postgres:postgres@localhost:5432/realestate

# Auth
AUTH_TOKEN_SECRET=your-auth-token-secret
AUTH_OTP_TTL_SECONDS=600
AUTH_ACCESS_TOKEN_SECONDS=3600
AUTH_REFRESH_TOKEN_SECONDS=604800

# Email Notification Provider (log | ses)
# Use "ses" in deployed environments. IAM role/instance credentials are used; do not put AWS keys here.
NOTIFICATION_EMAIL_MODE=ses

# AWS Configuration (shared by S3 and SES)
AWS_REGION=your-aws-region
AWS_S3_BUCKET=your-s3-bucket

# AWS SES Configuration (required when NOTIFICATION_EMAIL_MODE=ses)
# Senders must be on a verified SES identity (domain or email). Do not hardcode these in application code.
SES_SUPPORT_EMAIL=####
SES_INFO_EMAIL=####
SES_FROM_NAME=Multi Listing Services
# Optional fallback sender if a purpose-specific address is unset
# SES_FROM_EMAIL=no-reply@abdounrealestate.com
EMAIL_OTP_VERIFICATION_SUBJECT=Verify your email address

# SMS Notification Provider (log only for now)
NOTIFICATION_SMS_MODE=log

# Frontend base URL (used for invitation and password-setup links)
FRONTEND_BASE_URL=http://localhost:3000
# APP_BASE_URL is used as a fallback when FRONTEND_BASE_URL is unset
# APP_BASE_URL=http://localhost:3000
CORS_DEFAULT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Localization
SUPPORTED_LOCALES=en,ar,fr,es
DEFAULT_LOCALE=en
RTL_LOCALES=ar

# Marketplace defaults
DEFAULT_CURRENCY=JOD
DEFAULT_MEASUREMENT_UNIT=sqm
DEFAULT_COUNTRY=Jordan
DEFAULT_COUNTRY_ID=1
DEFAULT_CITY=Amman
UNTITLED_PROPERTY_TITLE=Untitled property
EXCLUSIVE_BADGE_LABEL=Exclusive
SEARCH_DEFAULT_LIMIT=50
SEARCH_DEFAULT_OFFSET=0
SEARCH_MAX_LIMIT=200
PROPERTY_SEARCH_DEFAULT_RADIUS_KM=10

# Maps / contact links
WHATSAPP_BASE_URL=https://wa.me
GOOGLE_MAPS_EMBED_BASE_URL=https://maps.google.com/maps
GOOGLE_MAPS_EMBED_ZOOM=15

# Geocoding
GEOCODING_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=Abdoun Real Estate API/1.0
GEOCODING_RATE_LIMIT_DELAY=1.1
GEOCODING_TIMEOUT_CONNECT=10
GEOCODING_TIMEOUT_READ=30
GEOCODING_EXTRA_DELAY_AFTER_403=2
GEOCODING_EXAMPLE_LATITUDE=31.9539
GEOCODING_EXAMPLE_LONGITUDE=35.9106

# OTP codes are delivered by email/SMS only and are never included in API responses.
# This flag is ignored for response bodies and is kept only for compatibility.
EXPOSE_OTP_IN_RESPONSE=false

# Optional explicit AWS credentials (prefer IAM roles on AWS infrastructure)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# AWS Cognito (required for signup confirmation, USER_PASSWORD_AUTH, password reset)
# COGNITO_REGION=us-west-2
# COGNITO_USER_POOL_ID=
# COGNITO_APP_CLIENT_ID=
# COGNITO_APP_CLIENT_SECRET=
# COGNITO_DOMAIN=
# SOCIAL_REDIRECT_URI=

# Azure OpenAI (optional)
# AZURE_OPENAI_KEY=
# AZURE_ENDPOINT=
# AZURE_API_VERSION=
# AZURE_DEPLOYMENT_NAME=
# AZURE_OPENAI_TEMPERATURE=0.3
# AZURE_OPENAI_MAX_TOKENS=100

# Legacy seed / import scripts
# LEGACY_SOURCE_API_BASE=
# LEGACY_SEED_SUBMITTER_EMAIL=
