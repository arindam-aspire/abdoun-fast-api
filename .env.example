# Application
ENVIRONMENT=local
DEBUG=false

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/realestate

# Auth
AUTH_TOKEN_SECRET=your-auth-token-secret
AUTH_OTP_TTL_SECONDS=600

# Email Notification Provider (log | ses)
NOTIFICATION_EMAIL_MODE=log

# AWS Configuration (shared by S3 and SES)
AWS_REGION=your-aws-region
AWS_S3_BUCKET=your-s3-bucket

# AWS SES Configuration (required when NOTIFICATION_EMAIL_MODE=ses)
SES_FROM_EMAIL=no-reply@your-domain.com
SES_FROM_NAME=Your Application Name
EMAIL_OTP_VERIFICATION_SUBJECT=Verify your email address

# SMS Notification Provider (log only for now)
NOTIFICATION_SMS_MODE=log

# Frontend base URL (used for invitation and password-setup links)
FRONTEND_BASE_URL=http://localhost:3000

# Development Only - expose OTP codes in API responses for local testing
# Set true while email delivery is unavailable so signup/confirm can proceed.
EXPOSE_OTP_IN_RESPONSE=true

# Optional explicit AWS credentials (prefer IAM roles on AWS infrastructure)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# AWS Cognito (required for signup confirmation, USER_PASSWORD_AUTH, password reset)
# COGNITO_REGION=us-west-2
# COGNITO_USER_POOL_ID=
# COGNITO_APP_CLIENT_ID=
# COGNITO_APP_CLIENT_SECRET=
# COGNITO_DOMAIN=

# Azure OpenAI (optional)
# AZURE_OPENAI_KEY=
# AZURE_ENDPOINT=
# AZURE_API_VERSION=
# AZURE_DEPLOYMENT_NAME=
